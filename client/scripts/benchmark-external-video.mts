// Run with: npx tsx scripts/benchmark-external-video.mts [MiB] [baseline-ref]
// Uses generated bytes rather than a codec benchmark: only file finalization is measured.
import { execFileSync } from "node:child_process";
import { mkdir, mkdtemp, open, rm, writeFile } from "node:fs/promises";
import { tmpdir } from "node:os";
import { join, resolve } from "node:path";
import { pathToFileURL } from "node:url";
import { randomBytes } from "node:crypto";
import fs from "node:fs/promises";
import { syncBuiltinESMExports } from "node:module";
import { performance } from "node:perf_hooks";
import { LocalAssetStore } from "../electron/localAssetStore";
import { finalizeExternalVideo } from "../electron/externalVideoFinalization";

const mib = Number(process.argv[2] ?? 512);
if (!Number.isInteger(mib) || mib < 1 || mib > 4096) throw new Error("Choose 1–4096 MiB.");
const baselineRef = process.argv[3] ?? "HEAD";
const root = await mkdtemp(join(tmpdir(), "worshipsync-finalization-benchmark-"));
const baselineModule = resolve("electron/.external-video-benchmark-baseline.ts");
let wroteBaseline = false;
const originalLink = fs.link;
const withoutHardLinks = process.argv.includes("--without-hard-links");
try {
  if (withoutHardLinks) {
    fs.link = async () => { throw Object.assign(new Error("unsupported"), { code: "ENOTSUP" }); };
    syncBuiltinESMExports();
  }
  const baselineSource = execFileSync("git", ["show", `${baselineRef}:client/electron/externalVideoFinalization.ts`], { encoding: "utf8" });
  await writeFile(baselineModule, baselineSource, { flag: "wx" });
  wroteBaseline = true;
  const baseline = await import(pathToFileURL(baselineModule).href);
  const sourcePath = join(root, "download.mp4");
  const handle = await open(sourcePath, "wx");
  try {
    const chunk = randomBytes(1024 * 1024);
    for (let i = 0; i < mib; i += 1) await handle.write(chunk);
    await handle.sync();
  } finally { await handle.close(); }
  const results: Array<{ implementation: string; milliseconds: number; MiB: number }> = [];
  // Alternate order to expose, rather than hide, cache/order effects.
  for (const [index, implementation] of ["baseline", "updated", "updated", "baseline"].entries()) {
    const destinationDirectory = join(root, `destination-${index}`);
    await mkdir(destinationDirectory);
    const store = new LocalAssetStore(join(root, `registry-${index}`));
    const started = performance.now();
    await (implementation === "baseline" ? baseline.finalizeExternalVideo : finalizeExternalVideo)({
      sourcePath, sourceDirectory: root, destinationDirectory,
      displayName: "Large video", assetId: `benchmark-${index}`, workspaceId: "benchmark",
      width: 1920, height: 1080, store,
    });
    results.push({ implementation, milliseconds: Math.round(performance.now() - started), MiB: mib });
  }
  console.log(JSON.stringify({ platform: process.platform, rootVolume: root.slice(0, 3), withoutHardLinks,
    note: "Generated non-sparse file; local temporary volume; warm OS caches; no USB measurement.", results }, null, 2));
} finally {
  fs.link = originalLink;
  syncBuiltinESMExports();
  if (wroteBaseline) await rm(baselineModule, { force: true });
  if (!resolve(root).startsWith(resolve(tmpdir()) + "/") && !resolve(root).startsWith(resolve(tmpdir()) + "\\")) throw new Error("Unexpected benchmark directory.");
  await rm(root, { recursive: true, force: true });
}
