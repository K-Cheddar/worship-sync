  "overrides": {
    "resolve-url-loader": "5.0.0",
    "esbuild": "^0.27.2"
  },
  "scripts": {
    "dev": "npm run electron",
    "build": "vite build",
    "build:heroku": "vite build --mode heroku",
    "build:electron": "electron-vite build",
    "build:lint": "npm run lint && vite build",
    "build:strict": "npm run lint:check && vite build",
    "preview": "vite preview",
    "electron": "electron-vite dev && wait-on https://local.worshipsync.net:3000 && electron .",
    "electron:build": "electron-vite build && electron-builder",
    "electron:build:win": "electron-vite build && electron-builder --win",
    "electron:build:mac": "electron-vite build && electron-builder --mac",
    "electron:build:linux": "electron-vite build && electron-builder --linux",
    "test": "jest --watchAll=false",
    "test:coverage": "jest --watchAll=false --coverage",
    "test:watch": "jest",
    "eject": "vite eject",
    "lint": "eslint src --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint src --ext .ts,.tsx,.js,.jsx --fix",
    "lint:check": "eslint src --ext .ts,.tsx,.js,.jsx --max-warnings 0",
    "type-check": "tsc --noEmit",
    "generate:maskable-icon": "node scripts/generate-maskable-icon.mjs"
  },
  "main": "dist-electron/main/main.js",
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "overrides": [
      {
        "files": [
          "src/**/*.{ts,tsx,js,jsx}"
        ],
        "excludedFiles": [
          "src/components/ui/**"
        ],
        "rules": {
          "no-restricted-imports": [
            "error",
            {
              "patterns": [
                {
                  "group": [
                    "@radix-ui/*"
                  ],
                  "message": "Import owner-aware primitives from components/ui; feature code uses app-facing controls."
                }
              ]
            }
          ]
        }
      },
      {
        "files": [
          "src/**/*.{ts,tsx,js,jsx}"
        ],
        "excludedFiles": [
          "src/components/ui/**",
          "src/components/Button/**",
          "src/components/Input/**",
          "src/components/TextArea/**",
          "src/components/Select/**",
          "src/components/Checkbox/**",
          "src/components/Toggle/**",
          "src/components/Modal/**",
          "src/components/TimePicker/TimePickerCountdown.tsx",
          "src/components/TimePicker/TimePickerTimer.tsx",
          "**/*.test.*",
          "**/__tests__/**"
        ],
        "rules": {
          "no-restricted-imports": [
            "error",
            {
              "patterns": [
                {
                  "group": [
                    "@radix-ui/*"
                  ],
                  "message": "Use the shared UI primitives or app-facing controls."
                },
                {
                  "group": [
                    "**/ui/Button",
                    "**/ui/Input",
                    "**/ui/Checkbox",
                    "**/ui/Switch",
                    "**/ui/Select",
                    "**/ui/Textarea",
                    "**/ui/dialog"
                  ],
                  "message": "Use the canonical app-facing Button, Input, Checkbox, Toggle, Select, TextArea or Modal."
                }
              ]
            }
          ]
        }
      }
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "keywords": [],
  "author": {
    "name": "WorshipSync",
    "email": "kevincheddar@gmail.com"
  },
  "license": "ISC",
  "description": "Worship Sync - From planning to presentation - worship in sync",
  "repository": {
